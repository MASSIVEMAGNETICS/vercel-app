{
  "name": "nexusynth-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.5.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dev:web": "npm run dev --workspace @nexusynth/web",
    "dev:api": "npm run dev --workspace @nexusynth/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @nexusynth/web",
    "build:api": "npm run build --workspace @nexusynth/api"
  },
  "devDependencies": {
    "@types/node": "^20.12.8",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "typescript": "5.5.4",
    "vitest": "^1.5.0"
  }
}
