{
  "files": [],
  "references": [
    { "path": "./packages/types" },
    { "path": "./packages/core" },
    { "path": "./packages/ui" },
    { "path": "./apps/api" },
    { "path": "./apps/web" }
  ],
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@nexusynth/types": ["packages/types/src"],
      "@nexusynth/types/*": ["packages/types/src/*"],
      "@nexusynth/core": ["packages/core/src"],
      "@nexusynth/core/*": ["packages/core/src/*"],
      "@nexusynth/ui": ["packages/ui/src"],
      "@nexusynth/ui/*": ["packages/ui/src/*"]
    }
  }
}
